{
  "name": "getthumbs",
  "version": "42.0.0",
  "description": "High-performance video thumbnail extraction app",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json && node copy-preload.js",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"node wait-and-electron.js\"",
    "electron:build": "npm run build && electron-builder --win && node package-multifolder.js",
    "start": "electron ."
  },
  "keywords": [
    "video",
    "tags",
    "extractor",
    "keywords",
    "electron",
    "react",
    "nsfw"
  ],
  "author": "ATK",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.getthumbs.app",
    "productName": "getThumbs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "getThumbs_v42.${ext}"
    },
    "portable": {
      "artifactName": "getThumbs_v42.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "getThumbs",
      "artifactName": "getThumbs_Setup_v42.exe",
      "uninstallDisplayName": "getThumbs Video Thumbnail Extractor"
    }
  }
}
